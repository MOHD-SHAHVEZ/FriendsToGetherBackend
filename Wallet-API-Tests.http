###############################################################################


### ─────────────────────────────────────────────────────────────────
### 5a. NO TOKEN — Unauthorized (401)
### ─────────────────────────────────────────────────────────────────
### 
### No Authorization header sent.
### 
### EXPECTED RESPONSE (401 Unauthorized):
### {
###   "success": false,
###   "message": "Authentication failed: Full authentication is required"
### }
### ─────────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/wallet/balance


### ─────────────────────────────────────────────────────────────────
### 5b. INVALID TOKEN — Unauthorized (401)
### ─────────────────────────────────────────────────────────────────
### 
### Expired or malformed JWT token.
### 
### EXPECTED RESPONSE (401 Unauthorized):
### {
###   "success": false,
###   "message": "Authentication failed: JWT token is invalid"
### }
### ─────────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/wallet/balance
Authorization: Bearer invalid_token_here_abc123


### ─────────────────────────────────────────────────────────────────
### 5c. INVALID TRANSACTION TYPE — Bad Request (400)
### ─────────────────────────────────────────────────────────────────
### 
### Sending an invalid type parameter.
### 
### EXPECTED RESPONSE (400 Bad Request):
### {
###   "success": false,
###   "message": "Logic Error: Failed to convert value..."
### }
### ─────────────────────────────────────────────────────────────────

GET {{baseUrl}}/api/wallet/transactions?type=INVALID_TYPE
Authorization: Bearer {{token}}



